# ---- Server ----
PORT=3500
NODE_ENV=development

# ---- Database ----
# Used for REAL accounts only. The Try Demo profiles always run on an in-memory MongoDB
# that is seeded on boot and wiped on restart, so they never touch this database.
# Leave empty for local development (real accounts then also live in memory).
# For a hosted deployment paste your MongoDB Atlas connection string:
# DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ridemates
DATABASE_URI=

# ---- Auth ----
# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated extra origins allowed to call the API (only needed if the client is hosted separately)
ALLOWED_ORIGINS=
